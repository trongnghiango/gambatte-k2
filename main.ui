<!-- main.ui -->
<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <requires lib="gtk+" version="2.16" />
    <object class="GtkWindow" id="main_window">
        <property name="title">L:A_N:application_ID:gambatte_PC:N</property>
        <property name="resizable">True</property>
        <child>
            <object class="GtkVBox" id="main_vbox">
                <property name="spacing">0</property>
                <child>
                    <object class="GtkHBox" id="top_bar">
                        <property name="spacing">10</property>
                        <child>
                            <object class="GtkButton" id="hamburger_btn">
                                <property name="label">  ☰  </property>
                                <property name="relief">GTK_RELIEF_NONE</property>
                                <property name="focus_on_click">False</property>
                                <signal name="clicked" handler="on_hamburger_click" />
                            </object>
                            <packing>
                                <property name="expand">False</property>
                                <property name="fill">False</property>
                                <property name="padding">8</property>
                            </packing>
                        </child>
                        <child>
                            <object class="GtkLabel" id="title_label">
                                <property name="label">GAMBATTE</property>
                            </object>
                            <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                            </packing>
                        </child>
                        <child>
                            <object class="GtkLabel" id="right_spacer">
                                <property name="label">      </property>
                            </object>
                            <packing>
                                <property name="expand">False</property>
                                <property name="fill">False</property>
                                <property name="padding">8</property>
                            </packing>
                        </child>
                    </object>
                    <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="padding">4</property>
                    </packing>
                </child>
                <child>
                    <object class="GtkHBox" id="center_hbox">
                        <child>
                            <object class="GtkLabel" id="left_spacer" />
                        </child>
                        <child>
                            <object class="GtkVBox" id="center_vbox">
                                <child>
                                    <object class="GtkLabel" id="top_spacer" />
                                </child>
                                <child>
                                    <object class="GtkEventBox" id="drawing_area_container">
                                        <child>
                                            <object class="GtkDrawingArea" id="drawing_area" />
                                        </child>
                                    </object>
                                    <packing>
                                        <property name="expand">False</property>
                                        <property name="fill">False</property>
                                    </packing>
                                </child>
                                <child>
                                    <object class="GtkLabel" id="bottom_spacer" />
                                </child>
                            </object>
                            <packing>
                                <property name="expand">False</property>
                                <property name="fill">False</property>
                            </packing>
                        </child>
                        <child>
                            <object class="GtkLabel" id="right_spacer_outer" />
                        </child>
                    </object>
                    <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                    </packing>
                </child>
                <child>
                    <object class="GtkDrawingArea" id="joystick_area" />
                    <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                    </packing>
                </child>
            </object>
        </child>
    </object>
</interface>
